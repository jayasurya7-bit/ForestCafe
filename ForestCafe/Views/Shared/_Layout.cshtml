<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Forest Cafe</title>
    <meta name="description" content="A cafe on Kalvarayan Hill, Salem — coffee, cakes, and brunch under a century-old banyan tree. Open 9am–7pm daily.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Nunito+Sans:wght@400;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="masthead">
        <div class="masthead-inner">
            <a href="#top" class="brand">
                <img src="~/images/logo.png" alt="The Forest Cafe" class="brand-logo">
                <span class="brand-text">The Forest Cafe</span>
            </a>
            <nav class="nav">
                <a href="#menu">Menu</a>
                <a href="#gallery">Gallery</a>
                <a href="#reviews">Reviews</a>
                <a href="#visit" class="nav-cta">Visit Us</a>
            </nav>
            <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <div class="mobile-nav" id="mobileNav">
        <a href="#menu">Menu</a>
        <a href="#gallery">Gallery</a>
        <a href="#reviews">Reviews</a>
        <a href="#visit">Visit Us</a>
    </div>

    @RenderBody()

    <footer class="footer">
        <img src="~/images/logo.png" alt="The Forest Cafe" class="footer-logo">
        <p>&copy; <span id="year"></span> The Forest Cafe, Kalvarayan Hill. Love is in the air.</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
